APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB is the first-class local dev DB (DESIGN.md §4.4 needs FULLTEXT,
# which SQLite can't provide). Hostnames here assume Laravel Sail —
# `mariadb`, `redis`, `mailpit` are the Compose service names. If you run
# the stack outside Sail, swap them for 127.0.0.1.
# For a quick no-Docker spin-up, set DB_CONNECTION=sqlite and comment
# DB_HOST/PORT/DATABASE/USERNAME/PASSWORD; FULLTEXT search will degrade
# to LIKE per the conditional in the photos migration.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=photos
QUEUE_CONNECTION=database

# Photos disks: local in dev, s3 in prod. Drives both `photos` (public-read
# variants) and `photos_private` (originals) per DESIGN.md §11/§12.5.
PHOTOS_DRIVER=local
# Hard ceiling on accepted source image dimension (px). Above this the
# upload validator rejects with 422 (DESIGN.md §12.5, Appendix A).
PHOTOS_MAX_DIMENSION=8000
# Per-file size cap (KB). Mirrors `image|max:10240` in StorePhotosRequest.
PHOTOS_MAX_FILE_SIZE_KB=10240

# Sanctum: 24-hour token TTL (DESIGN.md §10.2). Minutes; 1440 = 24h.
SANCTUM_TOKEN_EXPIRATION=1440

# Seed credentials for the bootstrap admin (DESIGN.md §10.1, T016).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

# CORS allowlist target — never `*` in production (DESIGN.md §10.4).
FRONTEND_URL=http://localhost:5173

# Trusted reverse-proxy addresses. Empty in local dev (no proxy in front).
# In production set to '*' when running behind a single-tenant ALB/Nginx,
# or a comma-separated CIDR/IP list for stricter setups. Without this,
# $request->ip() resolves to the proxy and rate limiters key on a single
# shared bucket — see PR #4 review S4.
TRUSTED_PROXIES=

# Required when running long queue workers; a stale DB connection during
# the inter-job sleep must not survive into the next handle() call
# (DESIGN.md §12.6).
DB_PERSISTENT_CONNECTIONS=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` keeps mail in storage/logs/laravel.log out of the box. Inside Sail
# you can flip MAIL_MAILER=smtp + MAIL_HOST=mailpit to capture mail in the
# Mailpit UI at http://localhost:8025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local S3-compatible dev: Sail ships MinIO (sail/password). Pointing the
# AWS_* vars at MinIO lets you exercise the s3 driver locally without
# touching real AWS — leave PHOTOS_DRIVER=local for now and flip it to
# `s3` once you're ready to test the production code path against MinIO.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/local
AWS_USE_PATH_STYLE_ENDPOINT=true

# Production photo buckets — DESIGN.md §12.5. The public bucket is fronted
# by a CDN; the private bucket has Block Public Access ON and serves
# originals only via temporaryUrl() with 5-minute TTL.
# AWS_BUCKET_PUBLIC=photogallery-pro-prod
# AWS_BUCKET_PRIVATE=photogallery-pro-prod-private
# AWS_URL=https://cdn.example.com

# AWS SQS queue (production-only). Set QUEUE_CONNECTION=sqs to switch.
# SQS_KEY=
# SQS_SECRET=
# SQS_PREFIX=https://sqs.eu-west-1.amazonaws.com/123456789012
# SQS_QUEUE=photogallery-pro
# SQS_REGION=eu-west-1

VITE_APP_NAME="${APP_NAME}"
